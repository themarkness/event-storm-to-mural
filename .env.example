# Model provider: "gemini" (default, free via Google AI Studio) or "anthropic"
MODEL_PROVIDER=gemini

# Gemini — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic — only needed if MODEL_PROVIDER=anthropic
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

MURAL_TOKEN=your_mural_personal_access_token_here
MURAL_ID=your_mural_board_id_here
